---
interface Props {
	title?: string;
}

const { title = "Boda Katherine & Enrry - 21 de Noviembre 2026" } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		
		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Alex+Brush&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;0,700;1,400&family=Great+Vibes&family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;1,300&family=Pinyon+Script&display=swap" rel="stylesheet">
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--color-sage: #648550;
		--color-white: #FFFFFF;
		--color-pink: #F0C7C5;
		--color-gold: #7F6000;
		--color-brown: #633917;
		--color-bg-paper: #FDFBF7;
		--color-bg-alt: #F4EFEA;
		--color-text-muted: #8C7565;
		
		--font-serif: 'Cormorant Garamond', Georgia, serif;
		--font-script: 'Great Vibes', 'Alex Brush', cursive;
		--font-sans: 'Montserrat', sans-serif;
	}

	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html, body {
		width: 100%;
		min-height: 100vh;
		background-color: #557242;
		background-image: 
			radial-gradient(circle at 50% 30%, rgba(127, 96, 0, 0.25) 0%, transparent 70%),
			radial-gradient(circle at 85% 85%, rgba(240, 199, 197, 0.2) 0%, transparent 60%),
			radial-gradient(circle at 15% 90%, rgba(99, 57, 23, 0.2) 0%, transparent 50%);
		font-family: var(--font-serif);
		color: var(--color-brown);
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
		overflow-x: hidden;
	}

	/* Custom Scrollbar */
	::-webkit-scrollbar {
		width: 6px;
	}
	::-webkit-scrollbar-track {
		background: #557242;
	}
	::-webkit-scrollbar-thumb {
		background: var(--color-gold);
		border-radius: 3px;
	}
</style>
